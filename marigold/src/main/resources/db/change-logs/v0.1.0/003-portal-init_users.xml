        </createTable>

        <createIndex tableName="user_contacts" indexName="idx_user_contacts_key">
            <column name="key" />
        </createIndex>
        <createIndex tableName="user_contacts" indexName="idx_user_contacts_value" using="gin">
            <column name="value" />
        </createIndex>

        <rollback>
            <dropTable tableName="user_contacts" />
        </rollback>
    </changeSet>


    <changeSet id="20261113064821.create-votes" author="Jeremy Zheng">
        <createTable tableName="votes">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="user_id" type="int">
                <constraints
                    nullable="false"
                    foreignKeyName="idx_user_contacts_user"
                    referencedTableName="users"
                    referencedColumnNames="id"
                    deleteCascade="true" />
            </column>
            <column name="ip" type="varchar(45)">
                <constraints nullable="false" />
            </column>
            <column name="stars" type="smallint">
                <constraints nullable="false" />
            </column>
            <column name="comment" type="jsonb">
                <constraints nullable="false" />
            </column>
            <column name="published_at" type="datetime" />
            <column name="deleted_at" type="datetime" />
            <column name="version" type="int" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="datetime">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex tableName="votes" indexName="idx_votes_ip">
            <column name="ip" />
        </createIndex>
        <createIndex tableName="votes" indexName="idx_votes_comment" using="gin">
            <column name="comment" />
        </createIndex>

        <rollback>
            <dropTable tableName="votes" />
        </rollback>
    </changeSet>

</databaseChangeLog>
