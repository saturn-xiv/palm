<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261113055125.create-currencies" author="Jeremy Zheng">
        <createTable tableName="currencies">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="name" type="varchar(127)">
                <constraints nullable="false" />
            </column>
            <column name="code" type="varchar(3)">
                <constraints nullable="false" />
            </column>
            <column name="country" type="varchar(127)">
                <constraints nullable="false" />
            </column>
            <column name="number" type="varchar(3)">
                <constraints nullable="false" />
            </column>
            <column name="units" type="int" />
            <column name="fund" type="boolean" />
            <column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex tableName="currencies" indexName="idx_currencies_name">
            <column name="name" />
        </createIndex>
        <createIndex tableName="currencies" indexName="idx_currencies_code">
            <column name="code" />
        </createIndex>
        <createIndex tableName="currencies" indexName="idx_currencies_country">
            <column name="country" />
        </createIndex>
        <createIndex tableName="currencies" indexName="idx_currencies_number">
            <column name="number" />
        </createIndex>

        <rollback>
            <dropTable tableName="currencies" />
        </rollback>
    </changeSet>

    <changeSet id="20261113055655.create-locales" author="Jeremy Zheng">
        <createTable tableName="locales">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="lang" type="varchar(7)">
                <constraints nullable="false" />
            </column>
            <column name="code" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="message" type="text">
                <constraints nullable="false" />
            </column>
            <column name="version" type="int" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="datetime">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex tableName="locales" indexName="idx_locales_lang">
            <column name="lang" />
        </createIndex>
        <createIndex tableName="locales" indexName="idx_locales_code">
            <column name="code" />
        </createIndex>
        <createIndex tableName="locales" indexName="idx_locales_lang_code" unique="true">
            <column name="lang" />
            <column name="code" />
        </createIndex>

        <rollback>
            <dropTable tableName="locales" />
        </rollback>
    </changeSet>

</databaseChangeLog>
