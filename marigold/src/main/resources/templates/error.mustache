<!DOCTYPE html>
<html lang="en_US" data-theme="dark">
  <head>
    {{> partials/bulma/assets}}
    <title>{{status}}-{{error}}</title>
  </head>
  <body>
    <section class="section">
      <div class="container">
          <section class="hero is-danger">
            <div class="hero-head">
              <div>{{timestamp}} <b>{{#tr}}flashes.failed{{/tr}}</b></div>
            </div>
            <div class="hero-body">
              <p class="title">Something went wrong ({{status}} - {{error}})</p>
              <p class="subtitle">Path: {{path}}</p>
            </div>
            <div class="hero-foot">
              <div class="buttons is-right">
                <a class="button is-link is-light" href="/">Go back home</a>
              </div>
            </div>
          </section>        
      </div>
    </section>
  </body>
</html>

