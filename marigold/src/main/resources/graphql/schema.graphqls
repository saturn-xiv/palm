scalar Date
scalar Time
scalar DateTime
scalar Url
scalar UUID

type Query {
  apiVersion: String!
  buildTime: DateTime!

  currencies: [Currency!]!
  timezones(lang: String!): [Timezone!]!
  languages(lang: String!): [Language!]!
  countryDialCodes(lang: String!): [CountryDialCode!]!

  localeByLang(lang: String!): [Locale!]!

  signInByWechatOauth2Url(
    client: String!
    redirectUri: String!
    lang: String!
  ): String!
  signInByGoogleOauth2Url(client: String!, redirectUri: String!): String!
  refresh(lang: String!): RefreshResponse!
}

type Mutation {
  setLocale(lang: String!, string: String!, message: String!): Succeed!

  signUpByEmail(request: SignUpByEmailRequest!): Succeed!
  signInByEmail(email: String!, password: String!): SignInResponse!
  confirmForEmailUser(email: String!): Succeed!
  confirmEmailUserByToken(token: String!): Succeed!
  unlockForEmailUser(email: String!): Succeed!
  unlockEmailUserByToken(token: String!): Succeed!
  forgotPasswordForEmailUser(email: String!): Succeed!
  resetPasswordForEmailUser(token: String!, password: String!): Succeed!
  signInByWechatOauth2(
    client: String!
    request: SignInByWechatOauth2Request!
  ): SignInResponse!
  signInByWechatMiniProgram(
    client: String!
    request: SignInByWechatMiniProgramRequest!
  ): SignInResponse!
  setInfoForWechatMiniProgramUser(
    nickname: String!
    avatarUrl: String!
  ): Succeed!
  signInByGoogleOauth2(
    client: String!
    request: SignInByGoogleOauth2Request!
  ): SignInResponse!
  revokeGoogleOauth2: Succeed!
}

type Succeed {
  createdAt: DateTime!
}

type Currency {
  code: String!
  name(lang: String!): String!
  fractionDigits: Int!
}

type Timezone {
  code: String!
  name: String!
}

type Locale {
  id: ID!
  lang: String!
  code: String!
  message: String!
  updatedAt: DateTime!
}

type Language {
  tag: String!
  name: String!
}

type CountryDialCode {
  name: String!
  code: Int!
  region: String!
}

input SignUpByEmailRequest {
  name: String!
  email: String!
  password: String!
  lang: String!
  timezone: String!
}

input SignInByWechatOauth2Request {
  code: String!
  state: String!
  lang: String!
  timezone: String!
}

input SignInByWechatMiniProgramRequest {
  code: String!
  lang: String!
  timezone: String!
}

input SignInByGoogleOauth2Request {
  code: String!
  redirectUri: String!
  state: String!
  lang: String!
  timezone: String!
}

type SignInResponse {
  token: String!
  page: PageLayout!
  user: CurrentUser!
}

type PageLayout {
  favicon: String
  title: String!
  subhead: String!
  author: Author!
  description: String!
  keywords: [String!]!
  copyright: String!
  locale: String!
  languages: [String!]!
  project: Project!
  buildTime: String!
}

type Project {
  name: String!
  url: String!
  version: String!
}

type Author {
  name: String!
  email: String!
}

type RefreshResponse {
  page: PageLayout!
  user: CurrentUser
}

type CurrentUser {
  lang: String!
  timezone: String!
  name: String!
  avatar: String
  isRoot: Boolean!
  isAdministrator: Boolean!
  roles: [String!]!
  permissions: [Permission!]!
}

type Resource {
  type: String!
  id: ID
}

type Permission {
  action: String!
  resource: Resource!
}
