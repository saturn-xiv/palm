  "git.ignoreLimitWarning": true,
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "server": "localhost",
      "port": 5432,
      "driver": "PostgreSQL",
      "name": "wisteria",
      "database": "wisteria_dev",
      "username": "www",
      "password": "change-me"
    }
  ],
  "java.compile.nullAnalysis.mode": "automatic",
  "cmake.sourceDirectory": "${workspaceFolder}/loquat"
}
