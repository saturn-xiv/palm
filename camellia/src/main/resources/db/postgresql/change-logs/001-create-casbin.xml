<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="2025.10.25.create-casbin" author="Jeremy Zheng">
        <createTable tableName="casbin_rule">
            <column name="id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="ptype" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="v0" type="varchar(100)" />
            <column name="v1" type="varchar(100)" />
            <column name="v2" type="varchar(100)" />
            <column name="v3" type="varchar(100)" />
            <column name="v4" type="varchar(100)" />
            <column name="v5" type="varchar(100)" />
        </createTable>
    </changeSet>

</databaseChangeLog>
