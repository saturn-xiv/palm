<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="Jeremy Zheng" id="20250217172509.create-questionnaire">
        <createTable tableName="questionnaire_forms">
            <column name="id" type="serial" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="uid" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="description_editor" type="varchar(15)">
                <constraints nullable="false"/>
            </column>
            <column name="profile" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(15)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="integer" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp without time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp without time zone" defaultValueComputed="current_timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_questionnaire_forms_uid" tableName="questionnaire_forms" unique="true">
            <column name="uid"/>
        </createIndex>
        <createIndex indexName="idx_questionnaire_forms_title" tableName="questionnaire_forms">
            <column name="title"/>
        </createIndex>
        <createIndex indexName="idx_questionnaire_forms_description_editor" tableName="questionnaire_forms">
            <column name="description_editor"/>
        </createIndex>
        <createIndex indexName="idx_questionnaire_forms_status" tableName="questionnaire_forms">
            <column name="status"/>
        </createIndex>

        <createTable tableName="questionnaire_fields">
            <column name="id" type="serial" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="form_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(31)">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="memo" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="memo_editor" type="varchar(15)">
                <constraints nullable="false"/>
            </column>
            <column name="profile" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="integer" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="integer" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp without time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp without time zone" defaultValueComputed="current_timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_questionnaire_fields_form_code" tableName="questionnaire_fields" unique="true">
            <column name="form_id"/>
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_questionnaire_fields_code" tableName="questionnaire_fields">
            <column name="code"/>
        </createIndex>
        <createIndex indexName="idx_questionnaire_fields_label" tableName="questionnaire_fields">
            <column name="label"/>
        </createIndex>
        <createIndex indexName="idx_questionnaire_fields_memo_editor" tableName="questionnaire_fields">
            <column name="memo_editor"/>
        </createIndex>

        <createTable tableName="questionnaire_polls">
            <column name="id" type="serial" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="form_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="field_id" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="batch_no" type="varchar(36)">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="ip" type="varchar(45)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="integer" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp without time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp without time zone" defaultValueComputed="current_timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_questionnaire_polls_batch_and_field" tableName="questionnaire_polls" unique="true">
            <column name="batch_no"/>
            <column name="field_id"/>
        </createIndex>
        <createIndex indexName="idx_questionnaire_polls_batch_no" tableName="questionnaire_polls">
            <column name="batch_no"/>
        </createIndex>
        <createIndex indexName="idx_questionnaire_polls_ip" tableName="questionnaire_polls">
            <column name="ip"/>
        </createIndex>

        <rollback>
            <dropTable tableName="questionnaire_polls"/>
            <dropTable tableName="questionnaire_fields"/>
            <dropTable tableName="questionnaire_forms"/>
        </rollback>
    </changeSet>

</databaseChangeLog>