namespace palm.tex.v1;

enum Class: byte { Article = 0, Report, Book, Letter, Beamer }

table Output {
    bucket: string (required);
    object: string (required);
}

table File {
    name: string (required);
    content: [ubyte] (required);
}

table Task {
    entry: string (required);
    class: Class;
    files: [File] (required);
    output: Output (required);
}
