bind 0.0.0.0
port {{ app_redis_port }}
protected-mode no
dir /var/lib/redis/cluster-node-{{ app_redis_port }}
logfile /var/log/redis/cluster-node-{{ app_redis_port }}.log
pidfile /run/redis-cluster-node-{{ app_redis_port }}.pid

cluster-enabled yes
cluster-config-file /tmp/redis-cluster-node-{{ app_redis_port }}.conf
cluster-node-timeout 5000

appendonly yes
appendfsync everysec
