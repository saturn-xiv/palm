An online education solution(v<%= version %>).

Usage:
    ./bin/bougainvillea eval 'Bougainvillea.Release.help'                   # Show usage
    ./bin/bougainvillea eval 'Bougainvillea.Release.version'                # Print version
    ./bin/bougainvillea eval 'Bougainvillea.Release.db_migrate'             # Apply all migrations
    ./bin/bougainvillea eval 'Bougainvillea.Release.db_status'              # Show database status
    ./bin/bougainvillea eval 'Bougainvillea.Release.db_rollback(VERSION)'   # Rollback a migration
    ./bin/bougainvillea eval 'Bougainvillea.Release.db_seed'                # Load data into database from priv folder
    ./bin/bougainvillea eval 'Bougainvillea.Release.list_user'              # List all users
    # Create an user by email address
    ./bin/bougainvillea eval 'Bougainvillea.Release.create_user_by_email("Who am I", "change-me@gmail.com", "password")'
    # Set password for email user
    ./bin/bougainvillea eval 'Bougainvillea.Release.set_password_for_email_user("change-me@gmail.com", "password")'
    # Assigns a role to a user
    ./bin/bougainvillea eval 'Bougainvillea.Release.add_role_for_user("user.sn", "role.code")'
    # Removes a role from a user
    ./bin/bougainvillea eval 'Bougainvillea.Release.delete_role_for_user("user.sn", "role.code")'
    # Generate a new JWT token for email user
    ./bin/bougainvillea eval 'Bougainvillea.Release.generate_token_by_email("change-me@gmail.com", ["sign-in"], 7)'

https://github.com/saturn-xiv/palm/tree/main/bougainvillea
